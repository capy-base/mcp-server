{
  "name": "@capydb/mcp",
  "version": "1.2.0",
  "description": "Official CapyDB MCP server - managed Postgres projects, preview databases, backups, restores, and SQL for AI agents.",
  "keywords": [
    "capydb",
    "postgres",
    "database",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "homepage": "https://capydb.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/capy-base/capydb-mcp"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "capydb-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "prepublishOnly": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@capydb/sdk": "^1.4.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
